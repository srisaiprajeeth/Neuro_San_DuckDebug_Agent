# Active local config: Azure OpenAI provider.
#
# "azure-gpt-4o-mini" is a built-in model key from neuro-san's default_llm_info.hocon,
# which supplies "class": "azure-openai" — so the class does not need repeating here.
#
# The endpoint, deployment and API version are set inline rather than via environment
# variables on purpose. neuro-san's AzureLlmPolicy reads them from the config FIRST and
# only then falls back to env vars, and the env-var names it expects are easy to get
# wrong: it wants AZURE_OPENAI_DEPLOYMENT_NAME (not ..._DEPLOYMENT) and OPENAI_API_VERSION
# (not AZURE_OPENAI_API_VERSION). Setting them here sidesteps that entirely.
#
# Only the secret stays in .env, read from AZURE_OPENAI_API_KEY.
{
	"llm_config": {
		"model_name": "azure-gpt-4o-mini",
		"deployment_name": "gpt-4o-mini",
		"azure_endpoint": "https://hr-mod-ai.openai.azure.com/",
		"openai_api_version": "2024-12-01-preview"
	}

	# To switch back to Gemini, comment out the block above and uncomment this.
	# Free-tier quota there is 20 requests/day PER MODEL and a multi-agent turn spends
	# several, which is why Azure is now the default.
	# "llm_config": {
	# 	"class": "gemini",
	# 	"model_name": "gemini-3.5-flash"
	# }
}
